# Optional: configure only if you want MongoDB-backed admin data.
# The app starts without MongoDB and serves the storefront locally.
MONGODB_URI=mongodb://127.0.0.1:27017/ahk_bridal_studio

# Frontend API origin and route prefix. Local Express backend runs on port 3000.
VITE_API_BASE_URL=http://localhost:3000/api

# Optional development server port (defaults to 3000).
# PORT=3000
